   <string notr="true">/* Фон и тонкая рамка выпадающего меню */
QWidget#Settings {
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-radius: 10px;
}

/* Имя пользователя (User) */
QWidget#Settings QLabel {
    background-color: transparent;
    color: #212121;
    font-size: 14px;
    font-weight: bold;
}

/* Обычные кнопки (Change the username) */
QWidget#Settings QPushButton {
    background-color: #f8f9fa;
    color: #212121;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}

QWidget#Settings QPushButton:hover {
    background-color: #e3f2fd;
    border: 1px solid #64b5f6;
    color: #0d47a1;
}

/* Если задашь кнопке Exit objectName = &quot;exit_btn&quot;, она станет аккуратной красной при наведении: */
QWidget#Settings QPushButton#exit_btn {
    color: #d32f2f;
}

QWidget#Settings QPushButton#exit_btn:hover {
    background-color: #ffebee;
    border: 1px solid #ef9a9a;
}
</string>
