  <property name="styleSheet">
   <string notr="true">/* Мягкий светлый градиент всего окна входа */
QWidget#loginCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #f5f7fa, stop:1 #e4ebf5);
}

/* Белая карточка формы (QGroupBox) */
QWidget#loginCard QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dbe4f0;
    border-radius: 12px;
    margin-top: 22px;
    padding: 16px;
    font-size: 15px;
    font-weight: bold;
    color: #1a237e;
}

/* Заголовок &quot;Авторизация&quot; */
QWidget#loginCard QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #1a237e;
}

/* Подписи полей (Логин, Пароль) */
QWidget#loginCard QLabel {
    background-color: transparent;
    color: #37474f;
    font-size: 13px;
    font-weight: bold;
}

/* Поля ввода логина и пароля */
QWidget#loginCard QLineEdit {
    background-color: #f8f9fa;
    color: #212121;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}

QWidget#loginCard QLineEdit:focus {
    border: 1px solid #64b5f6;
    background-color: #ffffff;
}

/* Второстепенные кнопки (Зарегистрироваться, Забыл пароль?, Войти debug) */
QWidget#loginCard QPushButton {
    background-color: #f8f9fa;
    color: #212121;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
}

QWidget#loginCard QPushButton:hover {
    background-color: #e3f2fd;
    border: 1px solid #90caf9;
    color: #0d47a1;
}

/* Главная голубая кнопка &quot;Войти&quot; (убедитесь, что её objectName = login_btn) */
QWidget#loginCard QPushButton#login_btn {
    background-color: #90caf9;
    color: #0d47a1;
    border: 1px solid #64b5f6;
    font-weight: bold;
}

QWidget#loginCard QPushButton#login_btn:hover {
    background-color: #64b5f6;
}
</string>
